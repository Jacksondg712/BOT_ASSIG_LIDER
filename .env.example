# =============================================================================
# VARIABLES DE ENTORNO — BOT_ASSIG_LIDER
# Copia este archivo como .env para desarrollo local.
# =============================================================================

# --- Salesforce: elige UNO de los dos metodos de autenticacion ---

# Opcion A - OAuth Password Flow (recomendado)
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=

# Comun a ambas opciones
SALESFORCE_USERNAME=
SALESFORCE_PASSWORD=
SALESFORCE_SECURITY_TOKEN=

SALESFORCE_BASE_URL=https://your-instance.my.salesforce.com
SALESFORCE_LOGIN_URL=https://login.salesforce.com
SALESFORCE_API_VERSION=v61.0

# --- Webhook (opcional, para cuando se pueda configurar un Flow en      ---
# --- Salesforce): token compartido que Salesforce debe enviar para que  ---
# --- el bot acepte la notificacion (?token=... en la URL, o header      ---
# --- X-Webhook-Token si el mecanismo elegido lo permite).               ---
LEAD_WEBHOOK_TOKEN=

# --- Polling (modo activo por ahora): revisa Salesforce cada N segundos ---
POLL_ENABLED=true
POLL_INTERVAL_SECONDS=60
POLL_BATCH_SIZE=20
# Ciclos seguidos que un Lead con error frena el checkpoint antes de pasarlo
# a la lista de reintentos (se sigue reintentando cada ciclo, sin bloquear).
POLL_MAX_LEAD_RETRIES=5
# Horas hacia atras que se revisan en cada ciclo buscando Leads que el
# checkpoint dejo atras y siguen sin asignar. 0 = desactivado.
POLL_LOOKBACK_HOURS=72

# --- Slack: DM al owner + registro de asignaciones en un canal ---
SLACK_BOT_TOKEN=xoxb-...
SLACK_NOTIFICATIONS_ENABLED=true
# Canal del registro. Vacio = cae a SLACK_TEST_CHANNEL_ID.
LEAD_ASSIGNMENT_CHANNEL_ID=
SLACK_TEST_CHANNEL_ID=

# Silencia el ruido de logs de httpx/httpcore (linea por linea de cada
# request a Salesforce/Slack) para que los logs [SLACK] no queden enterrados.
SLACK_TEST_MODE=false
